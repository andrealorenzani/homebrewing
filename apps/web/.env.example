# Copy this file to .env (dev) or .env.testing (test suite) and fill in real values.
# Never commit .env or .env.testing with real credentials.

# --- Application ---
# One of: development, production, testing
APP_ENV=development
# Enables verbose error output / disables error suppression when true.
APP_DEBUG=true
# Base URL the app is served from (no trailing slash), used to build absolute links
# (e.g. share URLs, QR code payloads).
APP_URL=http://localhost:8000

# --- Database (MariaDB/MySQL via PDO) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=homebrewing_dev
DB_USER=homebrewing
DB_PASS=changeme
DB_CHARSET=utf8mb4

# --- Homepage ---
# Number of most-recently-updated public recipes shown on the homepage
# card-grid showcase (GET /).
HOMEPAGE_RECIPE_COUNT=6

# --- Sessions ---
# Name of the PHP session cookie.
SESSION_NAME=homebrewing_session
# Set to true only when served over HTTPS (sets the "secure" cookie flag).
SESSION_SECURE=false

# --- Antispam / rate limiting ---
# Window (seconds) and max attempts used by the DB-backed rate limiter
# (see rate_limit_events table) for auth-related endpoints.
RATE_LIMIT_WINDOW_SECONDS=300
RATE_LIMIT_MAX_ATTEMPTS=10

# --- Sharing ---
# Length (bytes, before encoding) of generated share tokens for recipes/batches.
SHARE_TOKEN_BYTES=16
