{
    "name": "homebrewing/web",
    "description": "Homebrewing hobby web app (recipes, batches, sharing).",
    "type": "project",
    "version": "1.0.4",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "chillerlan/php-qrcode": "^6.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
